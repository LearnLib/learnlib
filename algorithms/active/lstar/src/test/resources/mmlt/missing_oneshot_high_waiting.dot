// This is an example of a model where we infer a periodic timer b that cannot be periodic, even with a high maximum waiting time.l
digraph g {

	s0 [timers="a=3" shape="circle"];
	s1 [timers="b=1" shape="circle"];
	s2 [timers="c=2" shape="circle"];

	s0 -> s1 [label="to[a] / A"];
	s1 -> s2 [label="to[b] / B"];
	s2 -> s2 [label="to[c] / C"];

	s1 -> s1 [label="x / X"];

__start0 [label="" shape="none" width="0" height="0"];
__start0 -> s0;

}

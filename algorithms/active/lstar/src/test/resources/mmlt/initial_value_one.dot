// The location s0 of this MMLT has a timer with the initial value one and a local reset.
// We allow local resets only in locations with at least two stable configurations.
// Hence, the smallest accurate hypothesis MMLT for this model must have two locations.
digraph g {

	s0 [timers="x=1,y=2" shape="circle"];

	s0 -> s0 [label="a / void" resets="x,y"];
	s0 -> s0 [label="to[x] / X"];
	s0 -> s0 [label="to[y] / Y"];

__start0 [label="" shape="none" width="0" height="0"];
__start0 -> s0;

}

// This is an example of a model where the greedy timer inference leads to an unnecessarily large model.
digraph g {

	s0 [timers="a=3" shape="circle"];
	s1 [timers="a=2,b=5" shape="circle"];

	s0 -> s1 [label="to[a] / a"];
	s1 -> s1 [label="to[a] / b"];
	s1 -> s1 [label="to[b] / c"];

__start0 [label="" shape="none" width="0" height="0"];
__start0 -> s0;

}

// In this example, the same output is produced multiple times at the same timeouts:
digraph g {

	s0 [timers="a=3,b=3,c=6,d=10" shape="circle"];

    s0 -> s0 [label="to[a] / A"];
    s0 -> s0 [label="to[b] / A"];
    s0 -> s0 [label="to[c] / B"];
    s0 -> s0 [label="to[d] / A|A"];

__start0 [label="" shape="none" width="0" height="0"];
__start0 -> s0;

}

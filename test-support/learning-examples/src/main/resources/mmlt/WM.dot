	s1 -> s2 [label="Door.Closed / Display.rem_normal,Door.lock,PumpIn.start"];
	s1 -> s0 [resets="a" label="Door.Open / Display.door_warning"];
	s1 -> s34 [label="to[a] / Display.off"];
